# Public settings from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key from Google AI Studio
GEMINI_API_KEY=

# Optional: comma-separated local hosts allowed to access Next.js dev assets
# Example: 192.168.1.10,10.0.0.5
ALLOWED_DEV_ORIGINS=
